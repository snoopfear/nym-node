[Unit]
Description=Nym Performance Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nym-performance-bot
EnvironmentFile=/opt/nym-performance-bot/.env
ExecStart=/opt/nym-performance-bot/venv/bin/python /opt/nym-performance-bot/bot.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
